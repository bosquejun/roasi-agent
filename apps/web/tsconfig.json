{
  "extends": "@roaster/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@roaster/ui/*": ["../../packages/ui/src/*"],
    },
    "plugins": [
      {
        "name": "next",
      },
    ],
    "types": [],
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
  ],
  "exclude": ["node_modules"],
}
